@@ -0,0 +1,43 @@
+"""Evaluation sandboxes on Apptainer: DockerBackend's interface without Docker (cooperbench.infra.apptainer)."""
+
+import subprocess
+
+from cooperbench.eval.backends.base import Sandbox
+from cooperbench.infra.apptainer import Container
+
+
+class ApptainerExecResult:
+    def __init__(self, returncode: int, output: str) -> None:
+        self._returncode, self._output = returncode, output
+
+    @property
+    def returncode(self) -> int:
+        return self._returncode
+
+    def stdout_read(self) -> str:
+        return self._output
+
+    def stderr_read(self) -> str:
+        return ""  # combined into stdout, as DockerExecResult does
+
+
+class ApptainerSandbox:
+    def __init__(self, container: Container, workdir: str, timeout: int = 600):
+        self._container, self._workdir, self._timeout = container, workdir, timeout
+
+    def exec(self, *args: str) -> ApptainerExecResult:
+        try:
+            r = self._container.run(list(args), cwd=self._workdir, timeout=self._timeout)
+        except subprocess.TimeoutExpired:
+            return ApptainerExecResult(-1, f"Command timed out after {self._timeout} seconds")
+        return ApptainerExecResult(r.returncode, r.stdout or "")
+
+    def terminate(self) -> None:
+        self._container.remove()
+
+
+class ApptainerBackend:
+    def create_sandbox(self, image: str, timeout: int = 600, workdir: str = "/workspace") -> Sandbox:
+        sandbox = ApptainerSandbox(Container(image), workdir, timeout)
+        sandbox.exec("mkdir", "-p", "/patches")
+        return sandbox
