diff --git a/src/cooperbench/agents/mini_swe_agent_v2/environments/apptainer.py b/src/cooperbench/agents/mini_swe_agent_v2/environments/apptainer.py
new file mode 100644
index 0000000..263eccd
--- /dev/null
+++ b/src/cooperbench/agents/mini_swe_agent_v2/environments/apptainer.py
@@ -0,0 +1,49 @@
+"""The agent's container on Apptainer: DockerEnvironment's interface and behaviour, without Docker.
+
+Each command runs with `apptainer exec` in the agent's own writable copy of the task image
+(cooperbench.infra.apptainer.Container), so files persist between commands as with `docker exec`. The working
+directory, environment variables, interpreter (bash -lc), timeout and the submission check are DockerEnvironment's.
+Not supported here: Docker networks and run_args (coop with a shared git server), which solo runs don't use.
+"""
+
+import os
+import subprocess
+from typing import Any
+
+from cooperbench.agents.mini_swe_agent_v2.environments.docker import DockerEnvironment, DockerEnvironmentConfig
+from cooperbench.infra.apptainer import Container
+
+
+class ApptainerEnvironment(DockerEnvironment):
+    def __init__(self, **kwargs):
+        self.container: Container | None = None
+        super().__init__(config_class=DockerEnvironmentConfig, **kwargs)
+
+    def _start_container(self):
+        self.container = Container(self.config.image)
+        self.container_id = self.container.dir.name
+        self.logger.info(f"Started container {self.container_id} in {self.container.dir}")
+
+    def execute(self, action: dict, cwd: str = "", *, timeout: int | None = None) -> dict[str, Any]:
+        command = action.get("command", "")
+        cwd = cwd or self.config.cwd
+        assert self.container is not None, "Container not started"
+        env = {k: v for k in self.config.forward_env if (v := os.getenv(k)) is not None}
+        env.update(self.config.env)
+        try:
+            result = self.container.run([*self.config.interpreter, command], cwd=cwd, env=env,
+                                        timeout=timeout or self.config.timeout)
+            output = {"output": result.stdout, "returncode": result.returncode, "exception_info": ""}
+        except Exception as e:
+            raw = getattr(e, "output", None)
+            raw = raw.decode("utf-8", errors="replace") if isinstance(raw, bytes) else (raw or "")
+            output = {"output": raw, "returncode": -1,
+                      "exception_info": f"An error occurred while executing the command: {e}",
+                      "extra": {"exception_type": type(e).__name__, "exception": str(e)}}
+        self._check_finished(output)
+        return output
+
+    def cleanup(self):
+        if getattr(self, "container", None) is not None:
+            self.container.remove()
+            self.container = None
