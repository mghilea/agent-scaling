new file mode 100644
index 0000000..b3d4997
--- /dev/null
+++ b/src/cooperbench/infra/apptainer.py
@@ -0,0 +1,87 @@
+"""Apptainer containers for CooperBench, for clusters without Docker (added for Neuronic).
+
+A task image (a Docker Hub image) is unpacked once per node into a sandbox directory under $COOPERBENCH_IMAGES
+(default /scratch/$USER/cooperbench/images), which needs no root and leaves its files owned by the user. Each
+container is a fast copy of that directory (reflink where the filesystem supports it) under
+$COOPERBENCH_CONTAINERS, with its own /tmp, so its changes persist from one command to the next, as with
+`docker run -d` + `docker exec`, and disappear with remove(). Commands run with --containall: none of the host's
+directories (home included) are visible, and the environment is the image's own. They run as the user, not root
+(the cluster has no --fakeroot), which is enough to edit the repo and pip-install, since the user owns every file.
+HOME is the image's own /root, as under Docker: images install tools there (e.g. rustup's toolchain in /root/.cargo,
+which the tiktoken tasks need to build); an empty home bound over /root would hide them.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import os
+import re
+import shutil
+import subprocess
+import uuid
+from pathlib import Path
+
+_USER = os.environ.get("USER", "user")
+IMAGES = Path(os.environ.get("COOPERBENCH_IMAGES", f"/scratch/{_USER}/cooperbench/images"))
+CONTAINERS = Path(os.environ.get("COOPERBENCH_CONTAINERS", f"/scratch/{_USER}/cooperbench/containers"))
+APPTAINER = os.environ.get("COOPERBENCH_APPTAINER", "apptainer")
+
+
+def _image_dir(image: str) -> Path:
+    return IMAGES / re.sub(r"[^A-Za-z0-9_.-]", "_", image)
+
+
+def ensure_image(image: str, timeout: int = 1800) -> Path:
+    """The image's sandbox directory, unpacked from docker://image if this node doesn't have it yet."""
+    target = _image_dir(image)
+    if (target / ".complete").exists():
+        return target
+    IMAGES.mkdir(parents=True, exist_ok=True)
+    env = dict(os.environ)
+    env.setdefault("APPTAINER_CACHEDIR", str(IMAGES.parent / "apptainer-cache"))
+    env.setdefault("APPTAINER_TMPDIR", str(IMAGES.parent / "apptainer-tmp"))
+    Path(env["APPTAINER_TMPDIR"]).mkdir(parents=True, exist_ok=True)
+    with open(IMAGES / f".{target.name}.lock", "w") as lock:  # concurrent runs build each image once
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        if not (target / ".complete").exists():
+            shutil.rmtree(target, ignore_errors=True)
+            subprocess.run([APPTAINER, "-q", "build", "--sandbox", str(target), f"docker://{image}"],
+                           check=True, env=env, timeout=timeout, capture_output=True, text=True)
+            (target / ".complete").touch()
+    return target
+
+
+class Container:
+    """A writable copy of an image, its /tmp and its home; commands run in it with `apptainer exec`."""
+
+    def __init__(self, image: str):
+        base = ensure_image(image)
+        CONTAINERS.mkdir(parents=True, exist_ok=True)
+        self.dir = CONTAINERS / f"{base.name}-{uuid.uuid4().hex[:8]}"
+        self.root = self.dir / "root"
+        self.tmp = self.dir / "tmp"
+        self.home = self.root / "root"  # the image's own /root (the container's copy of it), bound as HOME=/root
+        self.dir.mkdir()
+        subprocess.run(["cp", "-a", "--reflink=auto", str(base), str(self.root)], check=True)
+        self.tmp.mkdir()
+        self.home.mkdir(exist_ok=True)
+
+    def command(self, argv: list[str], cwd: str | None = None, env: dict[str, str] | None = None) -> list[str]:
+        # -s: only errors, so a warning (e.g. about /etc/localtime) can't precede the command's output
+        cmd = [APPTAINER, "-s", "exec", "--writable", "--containall", "--bind", f"{self.tmp}:/tmp",
+               "--home", f"{self.home}:/root"]
+        if cwd:
+            cmd += ["--pwd", cwd]
+        for key, value in (env or {}).items():
+            cmd += ["--env", f"{key}={value}"]
+        return cmd + [str(self.root), *argv]
+
+    def run(self, argv: list[str], cwd: str | None = None, env: dict[str, str] | None = None,
+            timeout: int | None = None) -> subprocess.CompletedProcess:
+        """Run argv in the container; stdout and stderr together, as text."""
+        return subprocess.run(self.command(argv, cwd, env), text=True, encoding="utf-8", errors="replace",
+                              timeout=timeout, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                              stderr=subprocess.STDOUT)
+
+    def remove(self) -> None:
+        shutil.rmtree(self.dir, ignore_errors=True)
